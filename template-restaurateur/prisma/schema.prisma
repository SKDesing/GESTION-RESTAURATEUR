
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  RESTAURATEUR
  MANAGER
  SERVEUR
  CUISINIER
  CLIENT
}

enum StatutTable {
  DISPONIBLE
  OCCUPEE
  RESERVEE
  NETTOYAGE
}

enum StatutCommande {
  EN_COURS
  EN_PREPARATION
  PRETE
  SERVIE
  PAYEE
  ANNULEE
}

enum StatutReservation {
  EN_ATTENTE
  CONFIRMEE
  ANNULEE
}

model Groupe {
  id              String          @id @default(cuid())
  nom             String
  description     String?
  etablissements  Etablissement[]
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
}

model Etablissement {
  id              String    @id @default(cuid())
  nom             String
  adresse         String
  telephone       String?
  email           String?
  logo            String?
  SIRET           String?   @unique
  SIREN           String?
  TVA             Float     @default(0.20)
  formeJuridique  String?
  horaires        Json?
  fraisDeService  Float?    @default(0)

  groupeId        String?
  groupe          Groupe?   @relation(fields: [groupeId], references: [id])
  employes        Employe[]
  menus           Menu[]
  tables          Table[]
  reservations    Reservation[]
  commandes       Commande[]
  stocks          Stock[]
  zCaisses        ZCaisse[]
  userEtablissements UserEtablissement[]

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model User {
  id        String    @id @default(cuid())
  email     String    @unique
  password  String
  nom       String
  prenom    String
  role      Role      @default(CLIENT)
  actif     Boolean   @default(true)
  employe   Employe?
  userEtablissements UserEtablissement[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Employe {
  id               String  @id @default(cuid())
  userId           String  @unique
  user             User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  etablissementId  String
  etablissement    Etablissement @relation(fields: [etablissementId], references: [id], onDelete: Cascade)
  role             Role    @default(SERVEUR)
  commandesPrises  Commande[] @relation("CommandesParServeur")
}

model Menu {
  id              String   @id @default(cuid())
  nom             String
  description     String?
  etablissementId String
  etablissement   Etablissement @relation(fields: [etablissementId], references: [id], onDelete: Cascade)
  categories      CategorieMenu[]
  estActif        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model CategorieMenu {
  id       String   @id @default(cuid())
  nom      String
  menuId   String
  menu     Menu     @relation(fields: [menuId], references: [id], onDelete: Cascade)
  plats    Plat[]
  ordre    Int      @default(0)
}

model Plat {
  id               String   @id @default(cuid())
  nom              String
  description      String?
  prix             Float
  imageUrl         String?
  tauxTva          Float    @default(0.20)
  disponibilite    Boolean  @default(true)
  categorieMenuId  String
  categorieMenu    CategorieMenu @relation(fields: [categorieMenuId], references: [id], onDelete: Cascade)
  allergenes       String?
  ingredients      String?
  commandePlats    CommandePlat[]
  stocks           Stock[]
  historiquePrix   HistoriquePrix[]
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model Table {
  id              String      @id @default(cuid())
  numero          String
  capacite        Int
  zone            String?
  statut          StatutTable @default(DISPONIBLE)
  etablissementId String
  etablissement   Etablissement @relation(fields: [etablissementId], references: [id], onDelete: Cascade)
  commandes       Commande[]
  reservations    Reservation[]
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
}

model Reservation {
  id               String          @id @default(cuid())
  nomClient        String
  nbCouverts       Int
  heureReservation DateTime
  statut           StatutReservation @default(EN_ATTENTE)
  tableId          String
  table            Table           @relation(fields: [tableId], references: [id])
  etablissementId  String
  etablissement    Etablissement  @relation(fields: [etablissementId], references: [id])
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
}

model Commande {
  id               String        @id @default(cuid())
  montantTotal     Float
  datePrise        DateTime      @default(now())
  datePaiement     DateTime?
  modePaiement     String?
  statut           StatutCommande @default(EN_COURS)
  tableId          String
  table            Table         @relation(fields: [tableId], references: [id])
  etablissementId  String
  etablissement    Etablissement @relation(fields: [etablissementId], references: [id])
  serveurId        String
  serveur          Employe       @relation("CommandesParServeur", fields: [serveurId], references: [id])
  commandePlats    CommandePlat[]
}

model CommandePlat {
  id        String  @id @default(cuid())
  quantite  Int
  prixUnit  Float
  commandeId String
  commande   Commande @relation(fields: [commandeId], references: [id], onDelete: Cascade)
  platId     String
  plat       Plat     @relation(fields: [platId], references: [id])
  @@unique([commandeId, platId])
}

model Stock {
  id               String  @id @default(cuid())
  quantiteActuelle Int
  seuilAlerte      Int     @default(5)
    platId           String
    plat             Plat    @relation(fields: [platId], references: [id])
    produitId        String?
    produit          Produit? @relation(fields: [produitId], references: [id])
    etablissementId  String
    etablissement    Etablissement @relation(fields: [etablissementId], references: [id])
    updatedAt        DateTime @updatedAt
}

model Produit {
  id           String  @id @default(cuid())
  nom          String
  description  String?
  prixAchat    Float
  fournisseurId String?
  fournisseur  Fournisseur? @relation(fields: [fournisseurId], references: [id])
  stocks       Stock[]
}

model Fournisseur {
  id          String    @id @default(cuid())
  nom         String
  contact     String?
  email       String?
  produits    Produit[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model ZCaisse {
  id               String   @id @default(cuid())
  dateCloture      DateTime @default(now())
  caTotalHT        Float
  caTotalTTC       Float
  totalTvaCollectede Float
  totalEspeces     Float
  totalCB          Float
  totalCheques     Float
  totalTR          Float
  nbTickets        Int
  ecart            Float?
  etablissementId  String
  etablissement    Etablissement @relation(fields: [etablissementId], references: [id])
}

model UserEtablissement {
  id               String  @id @default(cuid())
  userId           String
  user             User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  etablissementId  String
  etablissement    Etablissement @relation(fields: [etablissementId], references: [id], onDelete: Cascade)
  role             Role    @default(SERVEUR)
  @@unique([userId, etablissementId])
}

model HistoriquePrix {
    id            String   @id @default(cuid())
    ancienPrix    Float
    nouveauPrix   Float
    dateChangement DateTime @default(now())
    platId        String
    plat          Plat     @relation(fields: [platId], references: [id], onDelete: Cascade)
}

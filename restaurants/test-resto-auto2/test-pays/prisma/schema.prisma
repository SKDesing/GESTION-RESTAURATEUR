// ==========================================
// SCHÉMA PRISMA COMPLET - GESTION RESTAURANT
// Version Professionnelle 2024
// ==========================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================
// 1. STRUCTURE MULTI-ÉTABLISSEMENTS
// ==========================================

model Groupe {
  id              String          @id @default(cuid())
  nom             String
  logo            String?
  etablissements  Etablissement[]
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@map("groupes")
}

model Etablissement {
  id                String                      @id @default(cuid())
  nom               String
  enseigne          String
  siren             String                      @unique
  siret             String                      @unique
  tva               String
  formeJuridique    String
  adresse           String
  codePostal        String
  ville             String
  telephone         String
  email             String
  gpsLat            Float?
  gpsLng            Float?
  groupe            Groupe                      @relation(fields: [groupeId], references: [id])
  groupeId          String
  
  // Relations
  employes          Employe[]
  stocks            Stock[]
  categoriesMenu    CategorieMenu[]
  tables            Table[]
  reservations      Reservation[]
  commandes         Commande[]
  caisses           ZCaisse[]
  fournisseurs      FournisseurEtablissement[]
  
  createdAt         DateTime                    @default(now())
  updatedAt         DateTime                    @updatedAt

  @@map("etablissements")
}

// ==========================================
// 2. UTILISATEURS & EMPLOYÉS
// ==========================================

enum Role {
  ADMIN
  MANAGER
  EMPLOYE
  CUISINIER
}

model User {
  id          String    @id @default(cuid())
  email       String    @unique
  password    String
  nom         String
  prenom      String
  role        Role      @default(EMPLOYE)
  actif       Boolean   @default(true)
  employe     Employe?
  
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("users")
}

model Employe {
  id                String        @id @default(cuid())
  user              User          @relation(fields: [userId], references: [id])
  userId            String        @unique
  etablissement     Etablissement @relation(fields: [etablissementId], references: [id])
  etablissementId   String
  
  poste             String
  tauxHoraire       Float
  dateEmbauche      DateTime
  dateSortie        DateTime?
  actif             Boolean       @default(true)
  
  // Relations
  commandes         Commande[]
  reservations      Reservation[]
  
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@map("employes")
}

// ==========================================
// 3. GESTION DES STOCKS
// ==========================================

model CategorieProduit {
  id        String    @id @default(cuid())
  nom       String
  ordre     Int       @default(0)
  produits  Produit[]
  
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@map("categories_produits")
}

model Produit {
  id          String            @id @default(cuid())
  nom         String
  reference   String            @unique
  unite       String
  categorie   CategorieProduit  @relation(fields: [categorieId], references: [id])
  categorieId String
  
  // Relations
  stocks      Stock[]
  ingredients PlatIngredient[]
  
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@map("produits")
}

model Stock {
  id                String        @id @default(cuid())
  produit           Produit       @relation(fields: [produitId], references: [id])
  produitId         String
  etablissement     Etablissement @relation(fields: [etablissementId], references: [id])
  etablissementId   String
  
  quantite          Float
  seuilAlerte       Float
  prixUnitaire      Float
  
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@unique([produitId, etablissementId])
  @@map("stocks")
}

// ==========================================
// 4. GESTION DU MENU
// ==========================================

model Allergene {
  id        String  @id @default(cuid())
  nom       String  @unique
  plats     Plat[]  @relation("PlatAllergenes")
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("allergenes")
}

model CategorieMenu {
  id                String        @id @default(cuid())
  nom               String
  ordre             Int           @default(0)
  etablissement     Etablissement @relation(fields: [etablissementId], references: [id])
  etablissementId   String
  
  plats             Plat[]
  
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@map("categories_menu")
}

model Plat {
  id            String          @id @default(cuid())
  nom           String
  description   String?
  prix          Float
  prixTTC       Float
  tauxTVA       Int             @default(10)
  disponible    Boolean         @default(true)
  
  categorie     CategorieMenu   @relation(fields: [categorieId], references: [id])
  categorieId   String
  
  // Relations
  allergenes    Allergene[]     @relation("PlatAllergenes")
  ingredients   PlatIngredient[]
  commandePlats CommandePlat[]
  
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@map("plats")
}

model PlatIngredient {
  id          String   @id @default(cuid())
  plat        Plat     @relation(fields: [platId], references: [id])
  platId      String
  produit     Produit  @relation(fields: [produitId], references: [id])
  produitId   String
  quantite    Float
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([platId, produitId])
  @@map("plats_ingredients")
}

// ==========================================
// 5. GESTION DES TABLES & RÉSERVATIONS
// ==========================================

model Table {
  id                String        @id @default(cuid())
  numero            Int
  capacite          Int
  zone              String?
  etablissement     Etablissement @relation(fields: [etablissementId], references: [id])
  etablissementId   String
  
  reservations      Reservation[]
  commandes         Commande[]
  
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@unique([numero, etablissementId])
  @@map("tables")
}

enum StatutReservation {
  EN_ATTENTE
  CONFIRMEE
  ANNULEE
  TERMINEE
}

model Reservation {
  id                String            @id @default(cuid())
  dateReservation   DateTime
  nombrePersonnes   Int
  nomClient         String
  telephoneClient   String
  emailClient       String?
  commentaire       String?
  statut            StatutReservation @default(EN_ATTENTE)
  
  table             Table             @relation(fields: [tableId], references: [id])
  tableId           String
  etablissement     Etablissement     @relation(fields: [etablissementId], references: [id])
  etablissementId   String
  employe           Employe?          @relation(fields: [employeId], references: [id])
  employeId         String?
  
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@map("reservations")
}

// ==========================================
// 6. GESTION DES COMMANDES
// ==========================================

enum StatutCommande {
  EN_COURS
  SERVIE
  PAYEE
  ANNULEE
}

enum ModePaiement {
  ESPECES
  CARTE_BANCAIRE
  TICKET_RESTAURANT
  AUTRE
}

model Commande {
  id                String         @id @default(cuid())
  numeroCommande    String         @unique
  statut            StatutCommande @default(EN_COURS)
  
  table             Table          @relation(fields: [tableId], references: [id])
  tableId           String
  etablissement     Etablissement  @relation(fields: [etablissementId], references: [id])
  etablissementId   String
  employe           Employe        @relation(fields: [employeId], references: [id])
  employeId         String
  
  montantHT         Float          @default(0)
  montantTVA        Float          @default(0)
  montantTTC        Float          @default(0)
  
  modePaiement      ModePaiement?
  datePaiement      DateTime?
  
  plats             CommandePlat[]
  
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  @@map("commandes")
}

model CommandePlat {
  id          String   @id @default(cuid())
  commande    Commande @relation(fields: [commandeId], references: [id])
  commandeId  String
  plat        Plat     @relation(fields: [platId], references: [id])
  platId      String
  
  quantite    Int      @default(1)
  prixUnitaire Float
  commentaire String?
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("commandes_plats")
}

// ==========================================
// 7. GESTION DES FOURNISSEURS
// ==========================================

model Fournisseur {
  id           String                     @id @default(cuid())
  nom          String
  contactNom   String?
  contactEmail String
  contactTel   String?
  adresse      String
  siret        String?
  
  etablissements FournisseurEtablissement[]
  
  createdAt    DateTime                   @default(now())
  updatedAt    DateTime                   @updatedAt

  @@map("fournisseurs")
}

model FournisseurEtablissement {
  fournisseur       Fournisseur   @relation(fields: [fournisseurId], references: [id])
  fournisseurId     String
  etablissement     Etablissement @relation(fields: [etablissementId], references: [id])
  etablissementId   String
  actif             Boolean       @default(true)
  
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  
  @@id([fournisseurId, etablissementId])
  @@map("fournisseurs_etablissements")
}

// ==========================================
// 8. RAPPORTS & CLÔTURES (Z CAISSE)
// ==========================================

model ZCaisse {
  id                String        @id @default(cuid())
  etablissement     Etablissement @relation(fields: [etablissementId], references: [id])
  etablissementId   String
  date              DateTime
  
  nombreTickets     Int
  chiffreAffaires   Float
  montantEspeces    Float
  montantCB         Float
  montantTickets    Float
  montantAutres     Float
  
  totalTVA10        Float
  totalTVA20        Float
  
  fondCaisseDebut   Float
  fondCaisseFin     Float
  
  cloture           Boolean       @default(false)
  clotureAt         DateTime?
  
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  
  @@unique([etablissementId, date])
  @@map("z_caisses")
}
